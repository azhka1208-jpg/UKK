// Prisma schema — port dari database MySQL SISTEMA.
// Untuk produksi di Vercel, ganti provider ke "postgresql" dan set DATABASE_URL Postgres.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  username      String   @unique
  email         String   @unique
  password      String
  phone         String?
  address       String?
  role          String   @default("peminjam") // admin | petugas | peminjam
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  borrowings         Borrowing[]  @relation("Borrower")
  approvedBorrowings Borrowing[]  @relation("Approver")
  activityLogs       ActivityLog[]
  notifications      Notification[]

  @@index([role])
  @@map("users")
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tools Tool[]

  @@map("categories")
}

model Tool {
  id             Int      @id @default(autoincrement())
  code           String   @unique
  name           String
  categoryId     Int      @map("category_id")
  description    String?
  stockTotal     Int      @default(0) @map("stock_total")
  stockAvailable Int      @default(0) @map("stock_available")
  condition      String   @default("baik") // baik | rusak_ringan | rusak_berat
  location       String?
  photo          String?
  status         String   @default("tersedia") // tersedia | perbaikan | tidak_tersedia
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  category         Category         @relation(fields: [categoryId], references: [id])
  borrowingDetails BorrowingDetail[]
  returnDetails    ReturnDetail[]

  @@index([categoryId])
  @@index([condition])
  @@index([status])
  @@map("tools")
}

model Borrowing {
  id              Int       @id @default(autoincrement())
  code            String    @unique
  userId          Int       @map("user_id")
  approvedBy      Int?      @map("approved_by")
  status          String    @default("menunggu") // menunggu | disetujui | ditolak | dipinjam | selesai | terlambat
  borrowDate      DateTime  @map("borrow_date")
  dueDate         DateTime  @map("due_date")
  purpose         String
  notes           String?
  rejectionReason String?   @map("rejection_reason")
  approvedAt      DateTime? @map("approved_at")
  pickedUpAt      DateTime? @map("picked_up_at")
  totalItems      Int       @default(0) @map("total_items")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user     User     @relation("Borrower", fields: [userId], references: [id])
  approver User?    @relation("Approver", fields: [approvedBy], references: [id])
  details  BorrowingDetail[]
  returnRecord ReturnRecord?

  @@index([userId])
  @@index([status])
  @@index([borrowDate])
  @@index([dueDate])
  @@map("borrowings")
}

model BorrowingDetail {
  id          Int      @id @default(autoincrement())
  borrowingId Int      @map("borrowing_id")
  toolId      Int      @map("tool_id")
  quantity    Int      @default(1)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  borrowing Borrowing @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  tool      Tool      @relation(fields: [toolId], references: [id])

  @@unique([borrowingId, toolId])
  @@index([borrowingId])
  @@index([toolId])
  @@map("borrowing_details")
}

model ReturnRecord {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  borrowingId Int       @unique @map("borrowing_id")
  receivedBy  Int?      @map("received_by")
  returnDate  DateTime  @map("return_date")
  status      String    @default("diajukan") // diajukan | diverifikasi
  lateDays    Int       @default(0) @map("late_days")
  fineAmount  Float     @default(0) @map("fine_amount")
  finePaid    Boolean   @default(false) @map("fine_paid")
  notes       String?
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  borrowing Borrowing      @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  receiver  User?          @relation(fields: [receivedBy], references: [id])
  details   ReturnDetail[]

  @@index([status])
  @@index([returnDate])
  @@map("returns")
}

model ReturnDetail {
  id        Int      @id @default(autoincrement())
  returnId  Int      @map("return_id")
  toolId    Int      @map("tool_id")
  quantity  Int      @default(1)
  condition String   @default("baik") // baik | rusak_ringan | rusak_berat
  note      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  returnRecord ReturnRecord @relation(fields: [returnId], references: [id], onDelete: Cascade)
  tool         Tool         @relation(fields: [toolId], references: [id])

  @@index([returnId])
  @@index([toolId])
  @@map("return_details")
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      Int?     @map("user_id")
  action      String
  description String?
  subjectType String?  @map("subject_type")
  subjectId   Int?     @map("subject_id")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false) @map("is_read")
  url       String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String?
  type      String   @default("string")
  group     String   @default("general")
  label     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}